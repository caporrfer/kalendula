---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { whatsappUrl } from '../data/site';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Bodas y eventos | Kaléndula Atelier" description="Diseño floral para bodas, ceremonias, mesas, celebraciones y eventos en Huelva." image="images/wedding.webp">
  <section class="event-hero" id="bodas">
    <figure><img src={`${base}images/wedding.webp`} width="1280" height="853" alt="Decoración exterior preparada para una celebración" fetchpriority="high"></figure>
    <div><p class="kicker">Bodas y eventos</p><h1>Flores que pertenecen al lugar.</h1><p>Partimos del espacio, la fecha y la forma en que queréis celebrar para construir una propuesta completa.</p><a class="button button-light" href={whatsappUrl('Hola, me gustaría solicitar información para una boda o evento.')} target="_blank" rel="noreferrer"><SocialIcon name="whatsapp" />Consultar disponibilidad</a></div>
  </section>

  <section class="event-intro section-shell"><p class="section-index">01 — Bodas</p><div><h2>Del ramo de novia a la última mesa.</h2><p>Podemos trabajar el ramo, la ceremonia, la bienvenida, los centros de mesa y otros rincones de la celebración. Cada elemento se plantea dentro de la misma línea floral.</p></div></section>

  <section class="event-list section-shell">
    <article><span>Ramo de novia</span><p>Diseñado según el estilo del vestido, la época del año y la manera de llevarlo.</p></article>
    <article><span>Ceremonia y altar</span><p>Intervenciones florales adaptadas a la escala y las condiciones del espacio.</p></article>
    <article><span>Mesas y centros</span><p>Composiciones que acompañan la mesa sin dificultar la conversación.</p></article>
    <article><span>Bienvenida y seating</span><p>Flores y detalles para ordenar la llegada de los invitados.</p></article>
  </section>

  <section class="event-collage"><figure><img src={`${base}images/gallery-7.webp`} width="1080" height="1334" alt="Ramo de novia de calas" loading="lazy"></figure><figure><img src={`${base}images/gallery-2.webp`} width="1080" height="1350" alt="Detalles florales y complementos preparados en el atelier" loading="lazy"></figure><p>Una misma paleta.<br>Distintas escalas.</p></section>

  <section class="event-intro section-shell" id="eventos"><p class="section-index">02 — Eventos</p><div><h2>Celebraciones particulares y encuentros de empresa.</h2><p>Preparamos decoración para cumpleaños, bautizos, comuniones y eventos corporativos. También podemos integrar globos personalizados, papelería y rincones específicos cuando el proyecto lo requiere.</p></div></section>

  <section class="planning section-shell"><div><p class="kicker">Para preparar la consulta</p><h2>Qué necesitamos saber.</h2></div><ul><li>Fecha y ubicación</li><li>Tipo de celebración</li><li>Número aproximado de invitados</li><li>Espacios que quieres decorar</li><li>Referencias o colores, si ya los tienes</li></ul></section>

  <section class="contact-band contact-band-lilac"><p class="kicker">Bodas y eventos</p><h2>Comprobamos la fecha y hablamos del espacio.</h2><div><a class="button button-dark" href={whatsappUrl('Hola, me gustaría consultar disponibilidad para una boda o evento.')} target="_blank" rel="noreferrer"><SocialIcon name="whatsapp" />Consultar disponibilidad</a><a class="arrow-link" href={`${base}contacto/`}>Enviar una consulta detallada <span class="link-mark" aria-hidden="true"></span></a></div></section>
</BaseLayout>
