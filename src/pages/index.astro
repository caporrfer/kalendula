---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
const wa = 'https://wa.me/34623164848?text=Hola%2C%20he%20visitado%20la%20web%20de%20Kal%C3%A9ndula%20y%20me%20gustar%C3%ADa%20contaros%20una%20idea.';
const services = [
  ['01','Ramos de autor','Flores frescas y preservadas compuestas para decir exactamente lo que quieres.'],
  ['02','Bodas con alma','Del ramo de novia al último centro de mesa: una atmósfera floral con sentido.'],
  ['03','Eventos','Celebraciones íntimas, comuniones y encuentros de empresa diseñados a medida.'],
  ['04','Espacios','Escaparates, rincones y jardines preservados que cambian cómo se siente un lugar.']
];
const gallery = ['ai-workshop.webp','gallery-3.webp','ai-wedding.webp','gallery-1.webp','gallery-7.webp'];
---
<BaseLayout title="Kaléndula Atelier — Flores con intención en Huelva" description="Atelier floral en Corrales, Huelva. Ramos de autor, bodas, eventos y decoración floral personalizada.">
<div class="v1-shell" id="inicio"><a class="v1-skip" href="#contenido">Saltar al contenido</a>
<header class="v1-header"><a class="v1-wordmark" href="#inicio" aria-label="Kaléndula, inicio">KALÉNDULA <small>Atelier floral</small></a><nav aria-label="Navegación principal"><a href="#atelier">Atelier</a><a href="#servicios">Servicios</a><a href="#bodas">Bodas</a><a href="#contacto">Contacto</a></nav><a class="v1-pill" href={wa} target="_blank" rel="noreferrer">Hablemos <span>↗</span></a><button class="v1-menu" aria-label="Abrir menú" aria-expanded="false"><span></span><span></span></button></header>
<main id="contenido">
<section class="v1-hero"><div class="v1-hero-copy"><p class="v1-kicker">Corrales · Huelva</p><h1>Flores con<br><em>intención.</em></h1><p class="v1-lead">Diseñamos ramos, espacios y celebraciones que se recuerdan por cómo te hicieron sentir.</p><a class="v1-primary" href={wa} target="_blank" rel="noreferrer">Cuéntanos tu idea <span>↗</span></a></div><figure class="v1-hero-photo"><img src={`${base}images/ai-bouquet.webp`} alt="Ramo artesanal de flores de jardín en el atelier" width="1536" height="2048" fetchpriority="high"><figcaption><span>01</span> Composición de temporada</figcaption></figure><p class="v1-scroll">Desliza para descubrir <span>↓</span></p></section>
<section class="v1-manifesto" id="atelier"><p class="v1-index">01 / El atelier</p><div><h2>No hacemos dos veces<br>la misma <em>historia.</em></h2><div class="v1-manifesto-copy"><p>Escuchamos, observamos y damos forma a cada encargo con flores, color y textura.</p><p>Desde nuestro atelier en Corrales trabajamos de manera cercana y artesanal, eligiendo cada tallo para que el resultado tenga carácter propio.</p></div></div></section>
<section class="v1-craft"><div class="v1-craft-photo"><img src={`${base}images/ai-workshop.webp`} alt="Florista seleccionando tallos sobre una mesa de trabajo" width="2048" height="1365" loading="lazy"></div><blockquote>“Lo extraordinario empieza<br>en los pequeños gestos.”</blockquote></section>
<section class="v1-services" id="servicios"><header><p class="v1-index">02 / Lo que hacemos</p><h2>Una forma de celebrar.<br><em>Cuatro maneras de florecer.</em></h2></header><div class="v1-service-list">{services.map(([n,title,text]) => <article><span>{n}</span><h3>{title}</h3><p>{text}</p><a href={wa} aria-label={`Consultar sobre ${title}`}>Explorar servicio ↗</a></article>)}</div></section>
<section class="v1-wedding" id="bodas"><img src={`${base}images/ai-wedding.webp`} alt="Mesa de boda en un patio andaluz con decoración floral" width="2048" height="1365" loading="lazy"><div class="v1-wedding-panel"><p class="v1-index">03 / Bodas</p><h2>El paisaje de<br><em>vuestro día.</em></h2><p>Construimos una dirección floral completa que conecta el espacio, la estación y vuestra manera de celebrar.</p><ul><li>Ramo y complementos</li><li>Ceremonia y altar</li><li>Mesas y rincones</li></ul><a class="v1-primary light" href={wa} target="_blank" rel="noreferrer">Diseñemos vuestra boda ↗</a></div></section>
<section class="v1-gallery" aria-label="Selección de trabajos"><header><p class="v1-index">04 / Cuaderno visual</p><h2>Flores, lugares<br>y <em>momentos.</em></h2><a href="https://www.instagram.com/kalendulatelier/" target="_blank" rel="noreferrer">Ver Instagram ↗</a></header><div class="v1-track">{gallery.map((src,i) => <figure><img src={`${base}images/${src}`} alt={`Universo floral Kaléndula ${i+1}`} loading="lazy"><figcaption>0{i+1} / Kaléndula</figcaption></figure>)}</div></section>
<section class="v1-contact" id="contacto"><div><p class="v1-index">05 / Empecemos</p><h2>¿Qué tienes<br><em>en mente?</em></h2></div><div class="v1-contact-copy"><p>Cuéntanos la fecha, el lugar y esa idea que todavía no sabes explicar del todo. Nosotras ponemos las flores.</p><a class="v1-primary" href={wa} target="_blank" rel="noreferrer">Escribir por WhatsApp ↗</a><a href="tel:+34623164848">623 164 848</a><address>C. San Andrés · 21120 Corrales, Huelva</address></div></section>
</main><footer class="v1-footer"><a class="v1-wordmark" href="#inicio">KALÉNDULA <small>Atelier floral</small></a><div><a href={`${base}aviso-legal/`}>Legal</a><a href={`${base}privacidad/`}>Privacidad</a><a href={`${base}cookies/`}>Cookies</a></div><p>© {new Date().getFullYear()} Kaléndula Atelier</p></footer><nav class="v1-mobile-nav" aria-label="Accesos rápidos"><a href="#servicios"><span>✦</span>Servicios</a><a href={wa} target="_blank" rel="noreferrer"><span>↗</span>Pedir cita</a><a href="#contacto"><span>⌖</span>Visítanos</a></nav></div>
<script is:inline>const menu=document.querySelector('.v1-menu'),nav=document.querySelector('.v1-header nav');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{menu?.setAttribute('aria-expanded','false');nav?.classList.remove('open')}));</script>
</BaseLayout>
<style>
:global(body){background:#f2eee5;color:#1d2a23;font-family:'DM Sans',sans-serif}.v1-shell{--forest:#193329;--paper:#f2eee5;--coral:#d96f57;--lime:#dce69d;overflow:hidden;background:var(--paper)}.v1-skip{position:fixed;z-index:99;top:-4rem;left:1rem;background:#fff;padding:.8rem 1rem}.v1-skip:focus{top:1rem}
.v1-header{position:absolute;z-index:10;top:0;left:0;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;width:100%;padding:1.4rem 3vw;color:#fff}.v1-wordmark{display:inline-flex;flex-direction:column;width:max-content;font:400 1.2rem/1 'Italiana',serif;letter-spacing:.18em}.v1-wordmark small{margin-top:.35rem;font:500 .52rem/1 'DM Sans',sans-serif;letter-spacing:.3em;text-transform:uppercase}.v1-header nav{display:flex;gap:2.4rem;font-size:.72rem;text-transform:uppercase;letter-spacing:.12em}.v1-header nav a{padding:.7rem 0;border-bottom:1px solid transparent}.v1-header nav a:hover{border-color:currentColor}.v1-pill{justify-self:end;padding:.72rem 1.15rem;border:1px solid #ffffff8c;border-radius:99px;font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}.v1-pill span{margin-left:1rem}.v1-menu{display:none;border:0;background:none;color:#fff}.v1-menu span{display:block;width:22px;height:1px;margin:6px;background:currentColor}
.v1-hero{position:relative;display:grid;grid-template-columns:52% 48%;min-height:100svh;background:var(--forest);color:#fff}.v1-hero-copy{z-index:1;align-self:center;padding:9rem 4vw 7rem}.v1-kicker,.v1-index{margin:0 0 2rem;font-size:.64rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase}.v1-hero h1,.v1-manifesto h2,.v1-services h2,.v1-wedding h2,.v1-gallery h2,.v1-contact h2{margin:0;font:400 clamp(4.6rem,9vw,9rem)/.82 'Italiana',serif;letter-spacing:-.04em}.v1-hero h1 em,h2 em{color:var(--coral);font-weight:400}.v1-lead{max-width:32rem;margin:2.5rem 0;color:#dbe2dc;font-size:1.05rem}.v1-primary{display:inline-flex;align-items:center;justify-content:space-between;min-width:230px;padding:1rem 1.2rem;border-radius:2px;background:var(--coral);color:#fff;font-size:.76rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;transition:.25s}.v1-primary:hover{transform:translateY(-3px);background:#c85d48}.v1-primary.light{background:#fff;color:var(--forest)}
.v1-hero-photo{position:relative;margin:0;overflow:hidden}.v1-hero-photo:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#19332940,transparent 25%)}.v1-hero-photo img{height:100%;object-fit:cover}.v1-hero-photo figcaption{position:absolute;z-index:1;right:1.5rem;bottom:1.5rem;font-size:.64rem;text-transform:uppercase;letter-spacing:.13em}.v1-scroll{position:absolute;z-index:2;bottom:1.8rem;left:4vw;margin:0;font-size:.62rem;text-transform:uppercase;letter-spacing:.16em}.v1-scroll span,.v1-hero-photo figcaption span{margin-left:1rem}
.v1-manifesto{padding:9rem 5vw 11rem}.v1-manifesto>.v1-index{color:#6b776f}.v1-manifesto>div{display:grid;grid-template-columns:1.25fr .75fr;gap:8vw}.v1-manifesto h2,.v1-services h2,.v1-gallery h2,.v1-contact h2{font-size:clamp(3.5rem,6.6vw,7rem);line-height:.92}.v1-manifesto-copy{align-self:end;max-width:31rem}.v1-manifesto-copy p:first-child{font:1.6rem/1.35 'Italiana',serif}.v1-manifesto-copy p:last-child{color:#536057}.v1-craft{position:relative;padding:0 5vw 10rem}.v1-craft-photo{height:min(65vw,800px);overflow:hidden}.v1-craft-photo img{transition:transform 1s}.v1-craft-photo:hover img{transform:scale(1.025)}.v1-craft blockquote{position:absolute;right:2vw;bottom:5rem;margin:0;padding:2.2rem 3rem;background:var(--lime);font:clamp(1.4rem,2.5vw,2.5rem)/1.15 'Italiana',serif;transform:rotate(-2deg)}
.v1-services{padding:9rem 5vw;background:#e7e0d4}.v1-services header{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:6rem}.v1-services header .v1-index{order:2}.v1-service-list{border-top:1px solid #a9a79d}.v1-service-list article{display:grid;grid-template-columns:70px 1.1fr 1fr auto;align-items:center;gap:2rem;padding:2.1rem 0;border-bottom:1px solid #a9a79d;transition:.25s}.v1-service-list article:hover{padding-inline:1rem;background:#ffffff59}.v1-service-list article>span{font-size:.66rem}.v1-service-list h3{margin:0;font:2rem 'Italiana',serif}.v1-service-list p{max-width:35rem;margin:0;color:#59655d}.v1-service-list a{font-size:.68rem;text-transform:uppercase;letter-spacing:.1em}
.v1-wedding{position:relative;min-height:900px;color:#fff}.v1-wedding>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.v1-wedding:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#0c1e17cc,#0c1e1714 70%)}.v1-wedding-panel{position:relative;z-index:1;width:min(650px,90%);padding:11rem 5vw}.v1-wedding h2{font-size:clamp(4rem,7vw,7rem)}.v1-wedding-panel>p:not(.v1-index){max-width:31rem;margin:2.3rem 0;color:#e9ece9}.v1-wedding ul{padding:0;margin:2rem 0 3rem;list-style:none;border-top:1px solid #ffffff59}.v1-wedding li{padding:.8rem 0;border-bottom:1px solid #ffffff59;font-size:.8rem;text-transform:uppercase;letter-spacing:.1em}
.v1-gallery{padding:9rem 0;background:var(--forest);color:#fff}.v1-gallery header{display:grid;grid-template-columns:1fr 1fr auto;align-items:end;padding:0 5vw 5rem}.v1-gallery header .v1-index{align-self:start}.v1-gallery header a{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em}.v1-gallery h2{font-size:clamp(3.5rem,6vw,6.5rem)}.v1-track{display:flex;gap:1rem;padding:0 5vw 1rem;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.v1-track figure{flex:0 0 min(33vw,430px);margin:0;scroll-snap-align:start}.v1-track figure:nth-child(even){padding-top:5rem}.v1-track img{height:520px;object-fit:cover}.v1-track figcaption{margin-top:.8rem;font-size:.6rem;text-transform:uppercase;letter-spacing:.14em;color:#b7c1ba}
.v1-contact{display:grid;grid-template-columns:1.2fr .8fr;gap:8vw;padding:10rem 5vw;background:var(--lime)}.v1-contact h2{font-size:clamp(4rem,7vw,7.4rem)}.v1-contact-copy{align-self:end}.v1-contact-copy>p{max-width:30rem;font:1.45rem/1.4 'Italiana',serif}.v1-contact-copy>a:not(.v1-primary),.v1-contact address{display:block;margin-top:1.5rem;font-size:.78rem;font-style:normal}.v1-contact .v1-primary{margin:1.2rem 0}.v1-footer{display:grid;grid-template-columns:1fr auto 1fr;align-items:end;gap:2rem;padding:4rem 5vw;background:#10251d;color:#fff}.v1-footer>div{display:flex;gap:1.5rem;font-size:.68rem}.v1-footer>p{justify-self:end;margin:0;font-size:.65rem}.v1-mobile-nav{display:none}
@media(max-width:800px){.v1-header{grid-template-columns:1fr auto;padding:1.1rem 1rem}.v1-header nav{position:absolute;top:74px;right:1rem;left:1rem;display:none;padding:1.5rem;flex-direction:column;gap:.3rem;background:#f2eee5;color:var(--forest);box-shadow:0 18px 40px #0003}.v1-header nav.open{display:flex}.v1-header .v1-pill{display:none}.v1-menu{display:block;justify-self:end}.v1-wordmark{font-size:1rem}.v1-hero{display:block;min-height:100svh;padding-top:72px}.v1-hero-copy{position:absolute;z-index:2;bottom:5.5rem;left:0;padding:1.2rem}.v1-hero-copy:before{content:'';position:absolute;z-index:-1;inset:-5rem 0 -2rem;background:linear-gradient(0deg,#0d1e17f2,transparent)}.v1-hero h1{font-size:clamp(3.7rem,19vw,5.6rem)}.v1-lead{max-width:22rem;margin:1.2rem 0}.v1-primary{width:100%}.v1-hero-photo{height:calc(100svh - 72px)}.v1-hero-photo:after{background:linear-gradient(0deg,#0c1e1773,transparent 55%)}.v1-hero-photo figcaption,.v1-scroll{display:none}.v1-manifesto,.v1-services{padding:5.5rem 1.2rem}.v1-manifesto>div,.v1-contact{display:block}.v1-manifesto h2,.v1-services h2,.v1-gallery h2,.v1-contact h2{font-size:clamp(3rem,14.5vw,4.5rem)}.v1-manifesto-copy{margin-top:3rem}.v1-craft{padding:0 1.2rem 6rem}.v1-craft-photo{height:120vw}.v1-craft blockquote{right:.4rem;bottom:3.5rem;padding:1.4rem 1.2rem}.v1-services header{display:block;margin-bottom:3rem}.v1-services header .v1-index{margin-bottom:2rem}.v1-service-list article{grid-template-columns:35px 1fr;padding:1.5rem 0;gap:.8rem}.v1-service-list article p,.v1-service-list article a{grid-column:2}.v1-service-list h3{font-size:1.65rem}.v1-wedding{min-height:820px}.v1-wedding:after{background:linear-gradient(0deg,#0c1e17eb,#0c1e170d 78%)}.v1-wedding-panel{position:absolute;bottom:0;width:100%;padding:5rem 1.2rem 2rem}.v1-wedding h2{font-size:3.9rem}.v1-gallery{padding:5.5rem 0}.v1-gallery header{display:block;padding:0 1.2rem 3rem}.v1-gallery header a{display:inline-block;margin-top:2rem}.v1-track{padding-inline:1.2rem}.v1-track figure{flex-basis:82vw}.v1-track figure:nth-child(even){padding-top:2rem}.v1-track img{height:105vw;max-height:500px}.v1-contact{padding:6rem 1.2rem 7rem}.v1-contact-copy{margin-top:3rem}.v1-footer{display:flex;padding:4rem 1.2rem 7rem;flex-direction:column;align-items:flex-start}.v1-mobile-nav{position:fixed;z-index:30;right:.6rem;bottom:.6rem;left:.6rem;display:grid;grid-template-columns:repeat(3,1fr);padding:.55rem;border:1px solid #fff5;border-radius:14px;background:#10251df0;color:#fff;backdrop-filter:blur(12px)}.v1-mobile-nav a{display:flex;gap:.25rem;align-items:center;flex-direction:column;font-size:.58rem;text-transform:uppercase;letter-spacing:.06em}.v1-mobile-nav span{font-size:1rem}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
