---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { business, whatsappUrl } from '../data/site';
const base = import.meta.env.BASE_URL;
const services = [
  ['01', 'Ramos y composiciones', 'Flores frescas y preservadas, preparadas por encargo en el atelier.', `${base}servicios/#ramos`],
  ['02', 'Bodas', 'Ramo de novia, ceremonia, mesas y espacios pensados como un conjunto.', `${base}bodas-eventos/#bodas`],
  ['03', 'Eventos', 'Decoración para celebraciones particulares y encuentros de empresa.', `${base}bodas-eventos/#eventos`],
  ['04', 'Espacios', 'Musgo preservado, rincones botánicos y piezas para interiorismo.', `${base}servicios/#espacios`],
];
const gallery = [
  ['hero.webp','Ramo de flores rosas, blancas y azules preparado por Kaléndula'],
  ['gallery-4.webp','Trabajo floral en proceso sobre la mesa del atelier'],
  ['gallery-3.webp','Ramo de calas en tonos berenjena'],
  ['gallery-5.webp','Detalle de pared de musgo preservado con espejo'],
  ['gallery-2.webp','Flores y detalles preparados para una celebración'],
  ['gallery-7.webp','Ramo de novia con calas moradas y blancas'],
];
---
<BaseLayout title="Kaléndula Atelier | Floristería y decoración floral en Huelva" description="Ramos por encargo, bodas, eventos y decoración floral desde nuestro atelier en Corrales, Huelva.">
  <section class="home-hero">
    <div class="hero-heading">
      <p class="kicker">Floristería y atelier · Corrales</p>
      <h1>Flores con<br><em>carácter propio.</em></h1>
    </div>
    <figure class="hero-image"><img src={`${base}images/hero.webp`} width="1080" height="1350" alt="Ramo en tonos rosas, blancos y azules" fetchpriority="high"></figure>
    <div class="hero-detail">
      <p>Ramos por encargo, decoración de espacios y propuestas florales para bodas y celebraciones.</p>
      <a class="arrow-link" href={whatsappUrl()} target="_blank" rel="noreferrer"><SocialIcon name="whatsapp" />Hacer un encargo <span class="link-mark" aria-hidden="true"></span></a>
    </div>

  </section>

  <section class="service-index section-shell" aria-labelledby="service-title">
    <header class="section-heading"><p class="kicker">Lo que hacemos</p><h2 id="service-title">Del ramo de cada semana<br>al montaje de una boda.</h2></header>
    <div class="service-rows">
      {services.map(([number,title,copy,href]) => <a href={href}><span>{number}</span><h3>{title}</h3><p>{copy}</p><b class="link-mark" aria-hidden="true"></b></a>)}
    </div>
  </section>

  <section class="editorial-feature">
    <div class="feature-image"><img src={`${base}images/gallery-4.webp`} width="1080" height="1350" alt="Flores y materiales dispuestos en la mesa de trabajo" loading="lazy"></div>
    <div class="feature-copy"><p class="kicker">El atelier</p><h2>Primero la ocasión. Después, las flores.</h2><p>Trabajamos cada propuesta según el tipo de flor, el espacio y la fecha. Puedes venir con una idea cerrada o escribirnos para darle forma juntos.</p><a class="arrow-link" href={`${base}servicios/`}>Ver servicios <span class="link-mark" aria-hidden="true"></span></a></div>

  </section>

  <section class="work-gallery section-shell" id="trabajos" aria-labelledby="work-title">
    <header class="section-heading split"><div><p class="kicker">Trabajos recientes</p><h2 id="work-title">Una selección del atelier.</h2></div><a class="arrow-link" href={business.instagram} target="_blank" rel="noreferrer"><SocialIcon name="instagram" />Seguir en Instagram <span class="link-mark" aria-hidden="true"></span></a></header>
    <div class="masonry-gallery">{gallery.map(([src,alt],index) => <figure class={`gallery-${index+1}`}><img src={`${base}images/${src}`} alt={alt} width="1080" height="1350" loading={index < 2 ? 'eager' : 'lazy'} decoding="async"></figure>)}</div>
  </section>

  <section class="wedding-strip">
    <div class="wedding-strip-image"><img src={`${base}images/wedding.webp`} width="1280" height="853" alt="Montaje exterior para una celebración" loading="lazy"></div>
    <div class="wedding-strip-copy"><p class="kicker">Bodas y eventos</p><h2>La decoración empieza por el lugar.</h2><p>Diseñamos la propuesta floral atendiendo al espacio, la paleta y el tipo de celebración.</p><a class="button button-light" href={`${base}bodas-eventos/`}>Ver bodas y eventos</a></div>
  </section>

  <section class="contact-band">
    <p class="kicker">¿Tienes una fecha o una idea?</p><h2>Cuéntanos lo que necesitas.</h2><div><a class="button button-dark" href={whatsappUrl()} target="_blank" rel="noreferrer"><SocialIcon name="whatsapp" />Escribir por WhatsApp</a><a class="arrow-link" href={`${base}contacto/`}>Otras formas de contacto <span class="link-mark" aria-hidden="true"></span></a></div>
  </section>
</BaseLayout>
