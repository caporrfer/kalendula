---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro';
const wa='https://wa.me/34623164848?text=Hola%2C%20he%20visitado%20la%20web%20de%20Kal%C3%A9ndula%20y%20me%20gustar%C3%ADa%20solicitar%20informaci%C3%B3n%20sobre...';
const gallery=[['gallery-1.webp','Ramo floral de tonos naturales'],['gallery-2.webp','Decoración floral de celebración'],['gallery-3.webp','Detalle de flores para una ceremonia'],['gallery-4.webp','Composición floral artesanal'],['gallery-5.webp','Flores y texturas naturales'],['gallery-6.webp','Mesa decorada con flores'],['gallery-7.webp','Ramo de novia'],['gallery-8.webp','Diseño floral para eventos']];
---
<BaseLayout title="Kaléndula Atelier | Floristería y decoración floral en Huelva" description="Atelier floral en Corrales, Huelva. Ramos, flores frescas y preservadas, bodas, decoración y eventos personalizados.">
<Header /><main id="contenido">
<section class="hero" id="inicio"><div class="hero-copy"><p class="eyebrow">Atelier floral · Corrales, Huelva</p><h1>Flores que transforman <em>espacios y momentos.</em></h1><p>Diseño floral, decoración y eventos creados con sensibilidad, oficio y atención a cada detalle.</p><div class="actions"><a class="button" href="#galeria">Descubre nuestro trabajo</a><a class="text-link" href={wa}>Cuéntanos tu idea <span>↗</span></a></div></div><figure><img src="/images/hero.webp" width="1200" height="1500" alt="Composición floral elegante" fetchpriority="high"><figcaption>Kaléndula · Corrales</figcaption></figure></section>
<section class="intro section" id="atelier"><div><p class="eyebrow">El atelier</p><h2>Una mirada natural,<br><i>un trabajo personal.</i></h2></div><div class="intro-copy"><p class="lead">Cada ramo, espacio y celebración comienza con una idea.</p><p>En Kaléndula trabajamos con flores, texturas y detalles para crear composiciones con carácter propio. Una forma artesanal y cercana de dar vida a aquello que quieres celebrar.</p><a class="text-link" href="#servicios">Conoce lo que hacemos <span>↓</span></a></div></section>
<section class="atelier-image section"><img src="/images/gallery-1.webp" alt="Flores preparadas en el atelier" width="1400" height="900" loading="lazy"><p>Flores, color y textura.<br>Todo empieza en el detalle.</p></section>
<section class="services section" id="servicios"><header><p class="eyebrow">Servicios</p><h2>Flores para cada forma <i>de celebrar.</i></h2></header>
<div class="service-list"><article><span>01</span><div><h3>Floristería & atelier floral</h3><p>Ramos, composiciones, flores frescas y preservadas y encargos personalizados.</p></div></article><article><span>02</span><div><h3>Bodas</h3><p>Ramos de novia, ceremonia, altares, centros de mesa, rincón de bienvenida y decoración floral integral.</p></div></article><article><span>03</span><div><h3>Eventos & celebraciones</h3><p>Decoración para cumpleaños, bautizos, comuniones y eventos corporativos.</p></div></article><article><span>04</span><div><h3>Diseño & decoración</h3><p>Decoración de espacios, globos personalizados, papelería y rincones especiales.</p></div></article></div></section>
<section class="weddings" id="bodas"><div class="wedding-image"><img src="/images/gallery-6.webp" alt="Mesa de celebración decorada con flores" width="1200" height="1500" loading="lazy"></div><div class="wedding-copy"><p class="eyebrow">Bodas</p><h2>Diseñamos el escenario <i>de vuestro día.</i></h2><p>Cada celebración pide una atmósfera propia. Diseñamos la propuesta floral atendiendo al espacio, la paleta y los pequeños gestos que hacen que todo tenga sentido.</p><ul><li>Ramo de novia</li><li>Ceremonia y altar</li><li>Mesas y centros florales</li><li>Bienvenida y seating</li></ul><a class="button light" href={wa} target="_blank">Solicitar asesoramiento</a></div></section>
<section class="gallery section" id="galeria"><header><div><p class="eyebrow">Selección de trabajos</p><h2>Nuestro universo <i>floral.</i></h2></div><a class="text-link" href="https://www.instagram.com/kalendulatelier/" target="_blank" rel="noreferrer">@kalendulatelier ↗</a></header><div class="gallery-grid">{gallery.map(([src,alt],i)=><button class={`gallery-item item-${i+1}`} aria-label={`Ampliar: ${alt}`} data-src={`/images/${src}`} data-alt={alt}><img src={`/images/${src}`} alt={alt} width="800" height={i%3===0?'1000':'700'} loading="lazy"></button>)}</div></section>
<dialog id="lightbox"><button class="close" aria-label="Cerrar imagen">×</button><img src="" alt=""></dialog>
<section class="process section"><header><p class="eyebrow">Cómo trabajamos</p><h2>De una idea a <i>cada detalle.</i></h2></header><ol><li><span>01</span><h3>Cuéntanos tu idea</h3><p>Un evento, un ramo, un espacio o una celebración.</p></li><li><span>02</span><h3>Diseñamos la propuesta</h3><p>Flores, materiales, colores y composición.</p></li><li><span>03</span><h3>Lo hacemos realidad</h3><p>Preparamos cada elemento para que el conjunto cobre vida.</p></li></ol></section>
<section class="instagram"><div><p class="eyebrow">Instagram</p><h2>El día a día <i>del atelier.</i></h2><p>Flores que llegan, composiciones en proceso y celebraciones listas para empezar.</p><a class="button" href="https://www.instagram.com/kalendulatelier/" target="_blank" rel="noreferrer">Ver Instagram</a></div><div class="insta-images"><img src="/images/gallery-3.webp" alt="Detalle floral" loading="lazy"><img src="/images/gallery-7.webp" alt="Ramo floral" loading="lazy"></div></section>
<section class="contact section" id="contacto"><div class="contact-copy"><p class="eyebrow">Contacto</p><h2>Cuéntanos qué tienes <i>en mente.</i></h2><p>Si tienes una fecha, un espacio o simplemente una idea, escríbenos. Estaremos encantados de escucharte.</p><div class="contact-actions"><a class="button" href={wa} target="_blank">Escribir por WhatsApp</a><a href="tel:+34623164848" class="text-link">Llamar al 623 164 848</a></div></div><form id="contact-form"><label>Nombre<input name="nombre" autocomplete="name" required></label><label>Teléfono<input name="telefono" type="tel" autocomplete="tel" required></label><label>Email<input name="email" type="email" autocomplete="email"></label><label>Tipo de servicio<select name="servicio"><option>Ramo o composición</option><option>Boda</option><option>Evento o celebración</option><option>Decoración de espacio</option><option>Otro</option></select></label><label>Fecha del evento <small>(opcional)</small><input name="fecha" type="date"></label><label>Mensaje<textarea name="mensaje" rows="4" required></textarea></label><label class="check"><input type="checkbox" required> <span>He leído y acepto la <a href="/privacidad/">política de privacidad</a>.</span></label><button class="button" type="submit">Enviar consulta por WhatsApp</button></form></section>
<section class="visit"><div><p class="eyebrow">Visítanos</p><h2>Estamos en <i>Corrales.</i></h2></div><address><strong>Kaléndula Atelier</strong><br>C. San Andrés<br>21120 Corrales, Huelva<br>España</address><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Kal%C3%A9ndula+Calle+San+Andr%C3%A9s+21120+Corrales+Huelva" target="_blank">Cómo llegar ↗</a></section>
</main><footer><a class="brand" href="#inicio">Kaléndula <small>ATELIER</small></a><nav><a href="#atelier">Atelier</a><a href="#servicios">Servicios</a><a href="#bodas">Bodas</a><a href="#galeria">Galería</a><a href="#contacto">Contacto</a></nav><div><a href="/aviso-legal/">Aviso legal</a> · <a href="/privacidad/">Privacidad</a> · <a href="/cookies/">Cookies</a><p>© {new Date().getFullYear()} Kaléndula. Todos los derechos reservados.</p></div></footer>
<script is:inline>
const d=document.querySelector('#lightbox'),di=d?.querySelector('img');document.querySelectorAll('.gallery-item').forEach(b=>b.addEventListener('click',()=>{if(di){di.src=b.dataset.src;di.alt=b.dataset.alt}d?.showModal()}));d?.querySelector('.close')?.addEventListener('click',()=>d.close());d?.addEventListener('click',e=>{if(e.target===d)d.close()});
document.querySelector('#contact-form')?.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.target),msg=`Hola, he visitado la web de Kaléndula y me gustaría solicitar información.\n\nNombre: ${f.get('nombre')}\nTeléfono: ${f.get('telefono')}\nEmail: ${f.get('email')||'—'}\nServicio: ${f.get('servicio')}\nFecha: ${f.get('fecha')||'Por concretar'}\nMensaje: ${f.get('mensaje')}`;open(`https://wa.me/34623164848?text=${encodeURIComponent(msg)}`,'_blank','noopener')});
</script></BaseLayout>
