---
import BaseLayout from './BaseLayout.astro'; import Header from '../components/Header.astro';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${title} | Kaléndula Atelier`} description={`${title} de Kaléndula Atelier.`}><Header /><main class="legal"><p class="eyebrow">Kaléndula Atelier</p><h1>{title}</h1><slot /><p class="legal-note">Este texto deberá ser revisado y completado por la persona responsable del negocio antes de la publicación definitiva.</p></main><footer><a class="brand" href={base}>Kaléndula <small>ATELIER</small></a><div><a href={`${base}aviso-legal/`}>Aviso legal</a> · <a href={`${base}privacidad/`}>Privacidad</a> · <a href={`${base}cookies/`}>Cookies</a></div></footer></BaseLayout>
<style>:global(.header){background:var(--ivory);color:var(--ink)}.legal{max-width:850px;margin:auto;padding:10rem 1.25rem 7rem}.legal h1{font:clamp(3rem,7vw,6rem)/1 var(--serif);margin:0 0 3rem}.legal h2{font:2rem var(--serif);margin-top:2.5rem}.legal-note{border:1px solid #9a8d79;padding:1rem;margin-top:3rem;font-size:.85rem}</style>
