---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business, whatsappUrl } from '../data/site';

interface Props { title: string; description: string; image?: string; noindex?: boolean; }
const { title, description, image = 'images/hero.webp', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://kalendulatelier.es');
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL(`${base}${image}`, site);
const schema = {
  '@context': 'https://schema.org',
  '@type': ['Florist', 'LocalBusiness'],
  name: business.name,
  telephone: business.phoneE164,
  address: {
    '@type': 'PostalAddress', streetAddress: business.addressLine, postalCode: '21120',
    addressLocality: 'Corrales', addressRegion: 'Huelva', addressCountry: 'ES',
  },
  sameAs: [business.instagram],
  url: new URL(base, site).href,
};
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f0e8">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex,follow">}
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website"><meta property="og:locale" content="es_ES">
  <meta property="og:title" content={title}><meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}><meta property="og:image" content={socialImage}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href={`${base}images/logo.webp`} type="image/webp">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <Header />
  <main id="contenido"><slot /></main>
  <Footer />
  <a class="mobile-whatsapp" href={whatsappUrl()} target="_blank" rel="noreferrer" aria-label="Escribir por WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.6 12.6 0 0 0 5.1 22.1L3.4 28.5l6.5-1.7A12.6 12.6 0 1 0 16 3.2Zm0 22.9c-2 0-3.9-.6-5.5-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.3 10.3 0 1 1 16 26.1Zm5.7-7.7c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-1.9-.9-3.2-1.7-4.5-3.8-.3-.6.3-.6.9-1.9.1-.2.1-.4 0-.6l-1-2.5c-.3-.7-.6-.6-.9-.6h-.7c-.2 0-.6.1-1 .5-.3.4-1.3 1.3-1.3 3.2s1.4 3.7 1.6 4c.2.3 2.7 4.1 6.5 5.8 2.4 1 3.4 1.1 4.6.9.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.3-.4-.4-.7-.6Z"/></svg>
  </a>
</body>
</html>
