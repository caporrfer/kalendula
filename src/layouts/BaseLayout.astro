---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business, whatsappUrl } from '../data/site';

interface Props { title: string; description: string; image?: string; noindex?: boolean; }
const { title, description, image = 'images/hero.webp', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://kalendulatelier.es');
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL(`${base}${image}`, site);
const schema = {
  '@context': 'https://schema.org',
  '@type': ['Florist', 'LocalBusiness'],
  name: business.name,
  telephone: business.phoneE164,
  address: {
    '@type': 'PostalAddress', streetAddress: business.addressLine, postalCode: '21120',
    addressLocality: 'Corrales', addressRegion: 'Huelva', addressCountry: 'ES',
  },
  sameAs: [business.instagram],
  url: new URL(base, site).href,
};
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f0e8">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex,follow">}
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website"><meta property="og:locale" content="es_ES">
  <meta property="og:title" content={title}><meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}><meta property="og:image" content={socialImage}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href={`${base}images/logo.webp`} type="image/webp">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <Header />
  <main id="contenido"><slot /></main>
  <Footer />
  <a class="mobile-whatsapp" href={whatsappUrl()} target="_blank" rel="noreferrer"><span>WhatsApp</span><span aria-hidden="true">↗</span></a>
</body>
</html>
