---
const wa='https://wa.me/34623164848?text=Hola%2C%20he%20visitado%20la%20web%20de%20Kal%C3%A9ndula%20y%20me%20gustar%C3%ADa%20solicitar%20informaci%C3%B3n%20sobre...';
const base=import.meta.env.BASE_URL;
---
<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="header" id="header"><a href={`${base}#inicio`} class="brand" aria-label="Kaléndula, inicio"><img class="brand-logo" src={`${base}images/logo.webp`} width="150" height="150" alt="Logo de Kaléndula Atelier"></a>
<button class="menu-button" aria-expanded="false" aria-controls="nav"><span></span><span></span><span class="sr-only">Abrir menú</span></button>
<nav id="nav" aria-label="Navegación principal"><a href="#atelier">Atelier</a><a href="#servicios">Servicios</a><a href="#bodas">Bodas y eventos</a><a href="#galeria">Galería</a><a href="#contacto">Contacto</a></nav>
<a class="header-cta" href={wa} target="_blank" rel="noreferrer">Pedir presupuesto</a></header>
<script is:inline>
const h=document.querySelector('.header'),b=document.querySelector('.menu-button'),n=document.querySelector('#nav');
b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));n?.classList.toggle('open',!o)});
n?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{b?.setAttribute('aria-expanded','false');n?.classList.remove('open')}));
let ticking=false,scrolled=false;
const updateHeader=()=>{const next=scrollY>40;if(next!==scrolled){scrolled=next;h?.classList.toggle('scrolled',next)}ticking=false};
addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(updateHeader)}},{passive:true});
</script>
